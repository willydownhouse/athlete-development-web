# Must match athlete-development-service Auth.js configuration.
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
# Local Auth.js session cookie name/salt; must match backend AUTH_TOKEN_SALT.
AUTH_TOKEN_SALT=authjs.session-token

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Fastify API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001
