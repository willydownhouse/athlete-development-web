# Copy to .env.prod on the web VPS.
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# ATHLETE_DEVELOPMENT_WEB_IMAGE is set by CI during deploy. Set it here only
# when starting the production stack manually.
# ATHLETE_DEVELOPMENT_WEB_IMAGE=ghcr.io/<owner>/athlete-development-web:main
#
# NEXT_PUBLIC_API_URL is a Docker build-arg (https://api.acent.app). It is not
# a runtime compose variable. Changing it here does not update the browser bundle.

# Must match athlete-development-service AUTH_SECRET and AUTH_TOKEN_SALT exactly.
AUTH_SECRET=
AUTH_TOKEN_SALT=authjs.session-token
AUTH_URL=https://acent.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_WEBROOT_DIR=/var/www/certbot
