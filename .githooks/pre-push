#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

should_verify=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/dev | refs/heads/main)
      should_verify=1
      ;;
  esac
done

if [ "$should_verify" -eq 0 ]; then
  exit 0
fi

branch="${remote_ref#refs/heads/}"
echo "Running yarn verify before push to ${branch}..."
yarn verify
